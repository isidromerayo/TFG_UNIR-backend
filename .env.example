# Plantilla de variables de entorno del backend.
#
# Uso:
#   cp .env.example .env
#
# Después sustituye cada valor CHANGE_ME_* por uno propio. Este fichero es
# público: nunca debe contener secretos reales (el .env sí está en .gitignore).
#
# Genera el secreto JWT con:
#   openssl rand -base64 64

# PostgreSQL Configuration
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=tfg_unir
POSTGRES_USER=user_tfg

# Spring Boot Configuration
# La contraseña del backend es la misma que la de PostgreSQL (SPRING_DATASOURCE_PASSWORD
# se toma de POSTGRES_PASSWORD en docker-compose.yml y scripts/podman-pod.sh).
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tfg_unir
SPRING_DATASOURCE_USERNAME=user_tfg

# JWT Configuration (obligatorio: sin él la aplicación no arranca)
JWT_SECRET=CHANGE_ME_JWT_SECRET
